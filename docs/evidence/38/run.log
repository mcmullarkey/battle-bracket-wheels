GET / → 200
- <link rel="stylesheet" href="/static/css/space.css">  (default theme)
- <form class="theme-selector" action="/theme" method="post">
- <select name="theme" id="theme-select">
- <option value="space" selected>Space</option>  (server-rendered selected)

