<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Battle Bracket Wheels</title>
    <script src="/static/js/htmx.min.js"></script>
    <script src="/static/js/wheel.js"></script>
    <script>
      
      
      
      document.addEventListener('htmx:beforeSwap', function(evt) {
        if (evt.detail.xhr.status >= 400) {
          evt.detail.shouldSwap = true;
        }
      });
    </script>
    <link rel="stylesheet" href="/static/css/space.css">
</head>
<body>
    <div class="container">
        <h1 class="neon-gold">Battle Bracket Wheels</h1>
        <form class="theme-selector" action="/theme" method="post">
            <label for="theme-select">Theme:</label>
            <select name="theme" id="theme-select">
                
                <option value="space" selected>Space</option>
                
                <option value="y2k">Y2K</option>
                
            </select>
            <button type="submit" class="neon-button">Apply</button>
        </form>
        
<form class="populate-form" hx-post="/wheels/populate" hx-target="#populate-status" hx-swap="outerHTML">
  <label for="populate-items">Quick populate (one item per line, min 8):</label>
  <textarea name="items" id="populate-items" rows="4" placeholder="Movie 1&#10;Movie 2&#10;Movie 3&#10;..." required></textarea>
  <button type="submit" class="neon-button" hx-disabled-elt="this">Populate Wheels</button>
  <div id="populate-status" class="populate-status" aria-live="polite"></div>
</form>

        <div class="bracket" id="bracket">
            
            <div class="slot" id="slot-1">
<div id="wheel-slot-1-0">
  <svg viewBox="0 0 200 200" width="200" height="200">
    
    <polygon points="100,25 93,10 107,10" fill="#ffd700" stroke="#ffd700" stroke-width="1"/>
    <g class="wheel-group" id="wheel-group-slot-1-0">
      
      <circle cx="100" cy="100" r="10" fill="#ffd700" stroke="#fff" stroke-width="2"></circle>
    </g>
  </svg>
  
  <form hx-post="/wheel/0/option" hx-target="#wheel-slot-1-0" hx-swap="outerHTML">
    <input type="text" name="text" placeholder="Add option..." required>
    <button type="submit">Add</button>
  </form>
  
</div>
</div>
            <div class="match-center">
                <div id="battle-btn-qf1"><button class="neon-button" hx-post="/battle/qf1" hx-target="this" hx-swap="outerHTML">Battle QF1</button></div>
                <div id="match-qf1"></div>
            </div>
            <div class="slot" id="slot-2">
<div id="wheel-slot-2-1">
  <svg viewBox="0 0 200 200" width="200" height="200">
    
    <polygon points="100,25 93,10 107,10" fill="#ffd700" stroke="#ffd700" stroke-width="1"/>
    <g class="wheel-group" id="wheel-group-slot-2-1">
      
      <circle cx="100" cy="100" r="10" fill="#ffd700" stroke="#fff" stroke-width="2"></circle>
    </g>
  </svg>
  
  <form hx-post="/wheel/1/option" hx-target="#wheel-slot-2-1" hx-swap="outerHTML">
    <input type="text" name="text" placeholder="Add option..." required>
    <button type="submit">Add</button>
  </form>
  
</div>
</div>

            
            <div class="slot" id="slot-3">
<div id="wheel-slot-3-2">
  <svg viewBox="0 0 200 200" width="200" height="200">
    
    <polygon points="100,25 93,10 107,10" fill="#ffd700" stroke="#ffd700" stroke-width="1"/>
    <g class="wheel-group" id="wheel-group-slot-3-2">
      
      <circle cx="100" cy="100" r="10" fill="#ffd700" stroke="#fff" stroke-width="2"></circle>
