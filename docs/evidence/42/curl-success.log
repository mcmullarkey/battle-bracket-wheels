
<div id="slot-1" hx-swap-oob="true" class="slot pending-reveal">
  
<div id="wheel-slot-1-0">
  <svg viewBox="0 0 200 200" width="200" height="200">
    
    <polygon points="100,25 93,10 107,10" fill="#ffd700" stroke="#ffd700" stroke-width="1"/>
    <g class="wheel-group" id="wheel-group-slot-1-0">
      
        
          <path d="M 100.00 100.00 L 100.00 20.00 A 80.00 80.00 0 0 1 100.00 180.00 Z" class="wheel-slice" data-option="Movie 1"></path>
        
          <path d="M 100.00 100.00 L 100.00 180.00 A 80.00 80.00 0 0 1 100.00 20.00 Z" class="wheel-slice" data-option="Movie 1"></path>
        
        <text x="100.0" y="100.0" text-anchor="middle" dominant-baseline="middle" fill="#fff" font-size="11" font-family="Courier New, monospace" font-weight="bold" data-option-text="Movie 1">Movie 1</text>
      
      <circle cx="100" cy="100" r="10" fill="#ffd700" stroke="#fff" stroke-width="2"></circle>
    </g>
  </svg>
  
  <form hx-post="/wheel/0/option" hx-target="#wheel-slot-1-0" hx-swap="outerHTML">
    <input type="text" name="text" placeholder="Add option..." required>
    <button type="submit">Add</button>
  </form>
  
</div>

</div>

